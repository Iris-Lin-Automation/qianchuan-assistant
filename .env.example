# ============================================================
# 千川/抖店 × 飞书自动化 - 配置模板
# copy .env.example .env 后填写；勿提交真实密钥
# ============================================================

# 飞书群机器人 Webhook（卡片推送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 飞书多维表格 / 仪表盘分享链接（卡片大按钮跳转）
FEISHU_BITABLE_URL=https://xxx.feishu.cn/base/xxxxxxxx?table=xxxxx&view=xxxxx

# --- 方案 A：写入飞书多维表格（可选，配齐后自动云端入库）---
# 开放平台应用：https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 多维表格 URL 中的 app_token / table_id
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

REPORT_TITLE_PREFIX=千川/抖店数据日报
ALERT_THRESHOLD_PERCENT=20
DEBUG_MODE=false

# 定时：时区名（空=自动用本机）与本地推送时刻
SCHEDULE_TIMEZONE=Asia/Shanghai
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
